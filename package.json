{
  "name": "dsh-approval-zh",
  "version": "1.0.0",
  "description": "把 DSH 的权限审批卡片改成简单易懂的中文：说明这是什么操作、为什么被拦、允许后会发生什么，自动审查的英文理由会折叠成可查的原文。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "permission",
    "i18n",
    "chinese",
    "中文"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tian-yu-SKY/dsh-approval-zh.git"
  },
  "homepage": "https://github.com/Tian-yu-SKY/dsh-approval-zh#readme",
  "bugs": {
    "url": "https://github.com/Tian-yu-SKY/dsh-approval-zh/issues"
  }
}
